# Copiad este archivo a .env (nunca lo subáis al repositorio) y ajustad los valores.
# Estas URLs permiten que cada módulo apunte al mock de una dependencia o al servicio real,
# según lo que exista en cada momento del proyecto.

IDENTIDAD_URL=http://identidad:80
IDS_URL=http://ids:80
HONEYPOT_URL=http://honeypot:80
ESCANER_URL=http://escaner:80
SIEM_URL=http://siem:80
SOAR_URL=http://soar:80
DASHBOARD_URL=http://dashboard:80
PENTESTING_URL=http://pentesting:80

#Módulo 1
Add-Content -Encoding ascii .env.example @"

JWT_SECRET_KEY=
AES_KEY=
ADMIN_PASSWORD=
SERVICE_PASSWORD=
SECRET_DB_PASSWORD=
SECRET_API_KEY=
SECRET_JWT_SECRET=
"@