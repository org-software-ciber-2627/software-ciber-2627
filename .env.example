# Copiad este archivo a .env (nunca lo subáis al repositorio) y ajustad los valores.
# Estas URLs permiten que cada módulo apunte al mock de una dependencia o al servicio real,
# según lo que exista en cada momento del proyecto.

IDENTIDAD_URL=http://identidad:80
IDS_URL=http://ids:80
HONEYPOT_URL=http://honeypot:80
ESCANER_URL=http://escaner:80
SIEM_URL=http://siem:80
SOAR_URL=http://soar:80
DASHBOARD_URL=http://dashboard:80
PENTESTING_URL=http://pentesting:80

#Módulo 1
JWT_SECRET_KEY=
AES_KEY=
ADMIN_PASSWORD=
SERVICE_PASSWORD=
SECRET_DB_PASSWORD=
SECRET_API_KEY=
SECRET_JWT_SECRET=

PENTEST_MYSQL_ROOT_PASSWORD=replace-with-a-local-random-password
PENTEST_MYSQL_USER=pentest_app
PENTEST_MYSQL_PASSWORD=replace-with-another-local-random-password
PENTEST_E2E_TARGET_URL=http://honeypot/health
PENTEST_E2E_PORTS=80
PENTEST_E2E_HYDRA_SERVICE=http-post-form
PENTEST_E2E_HYDRA_USER=usuario-de-prueba
PENTEST_E2E_HYDRA_FORM=
PENTEST_E2E_USER_PASSWORD=