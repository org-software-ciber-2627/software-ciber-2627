# Copiad este archivo a .env (nunca lo subáis al repositorio) y ajustad los valores.
# Estas URLs permiten que cada módulo apunte al mock de una dependencia o al servicio real,
# según lo que exista en cada momento del proyecto.

IDENTIDAD_URL=http://identidad:80
IDS_URL=http://ids:80
HONEYPOT_URL=http://honeypot:80
ESCANER_URL=http://escaner:80
SIEM_URL=http://siem:80
SOAR_URL=http://soar:80
DASHBOARD_URL=http://dashboard:80
PENTESTING_URL=http://pentesting:80

#Módulo 1

JWT_SECRET_KEY=
AES_KEY=
ADMIN_PASSWORD=
# Transitoria: cuenta compartida "servicio" (la usa hoy el CI del SIEM; el IDS ya usa svc-ids)
SERVICE_PASSWORD=
# Una cuenta de rol servicio por módulo; si la variable está vacía, la cuenta no se crea
# Obligatoria para que el IDS se autentique: crea svc-ids en Identidad y es la contraseña del IDS.
# Un .env antiguo con solo SERVICE_PASSWORD hace fallar el login del IDS hasta que se defina esta.
SERVICE_PASSWORD_IDS=
SERVICE_PASSWORD_HONEYPOT=
SERVICE_PASSWORD_ESCANER=
SERVICE_PASSWORD_PENTESTING=
SERVICE_PASSWORD_SOAR=
SERVICE_PASSWORD_SIEM=
# Secreto que lee el SIEM al arrancar (dueño svc-siem); debe coincidir con SIEM_DB_PASSWORD
SECRET_SIEM_DB_PASSWORD=
SECRET_DB_PASSWORD=
SECRET_API_KEY=
SECRET_JWT_SECRET=
# Opcionales (el compose usa estos valores si no los definís): caducidad del JWT en segundos
# y nº de proxies de confianza delante de Identidad (en el compose, 1: el nginx del Dashboard)
#JWT_EXPIRES_SECONDS=1800
#TRUSTED_PROXY_HOPS=1

# Módulo 2: el IDS usa su cuenta svc-ids (contraseña: SERVICE_PASSWORD_IDS, arriba).
# No pongáis aquí "servicio": su contraseña ya no se pasa al IDS.
IDS_SERVICE_USERNAME=svc-ids
#Módulo 5 (SIEM con almacenamiento en PostgreSQL). Elegid una contraseña propia; el compose no arranca sin ella.
#Si el volumen siem-postgres-data ya existe, la contraseña no cambia al cambiar esta variable.
#Cuando el SIEM lea la contraseña de Identidad (secreto siem_db_password, SEM-133), el valor de G1
#(SECRET_SIEM_DB_PASSWORD) y este deben coincidir: PostgreSQL la usa al inicializar el volumen.

SIEM_DB_PASSWORD=
SIEM_DB_NAME=siem_bd
