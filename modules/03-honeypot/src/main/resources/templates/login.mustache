<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Iniciar sesión | HoneyPot</title>
    <style>
        :root {
            color-scheme: light;
            font-family: "Segoe UI", sans-serif;
            background: #eef3f0;
            color: #20332b;
        }

        * { box-sizing: border-box; }

        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: 24px;
            background: radial-gradient(circle at 15% 15%, #d7e8dd 0, transparent 34%), #eef3f0;
        }

        main {
            width: min(100%, 400px);
            padding: 40px;
            background: #fff;
            border: 1px solid #dce6df;
            border-radius: 8px;
            box-shadow: 0 18px 48px rgb(35 63 48 / 9%);
        }

        .mark {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            margin-bottom: 28px;
            border-radius: 8px;
            background: #dceee2;
            color: #286544;
            font-size: 22px;
            font-weight: 700;
        }

        h1 { margin: 0 0 8px; font-size: 26px; }
        p { margin: 0 0 28px; color: #66756d; line-height: 1.5; }

        label {
            display: block;
            margin: 18px 0 7px;
            font-size: 14px;
            font-weight: 600;
        }

        input {
            width: 100%;
            min-height: 44px;
            padding: 10px 12px;
            border: 1px solid #cbd8cf;
            border-radius: 5px;
            font: inherit;
        }

        input:focus { outline: 2px solid #6ca982; outline-offset: 2px; }

        button {
            width: 100%;
            min-height: 46px;
            margin-top: 26px;
            border: 0;
            border-radius: 5px;
            background: #286544;
            color: #fff;
            font: inherit;
            font-weight: 600;
            cursor: pointer;
        }

        button:hover { background: #1f5036; }

        .message {
            margin: 18px 0 0;
            padding: 11px 12px;
            border-left: 3px solid #c88432;
            background: #fff6e9;
            color: #67451e;
            font-size: 14px;
        }

        @media (max-width: 480px) { main { padding: 30px 24px; } }
    </style>
</head>
<body>
<main>
    <div class="mark" aria-hidden="true">H</div>
    <h1>Iniciar sesión</h1>
    <p>Accede a tu cuenta de HoneyPot.</p>

    <form action="/login" method="post">
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" autocomplete="username" required>

        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>

        <button type="submit">Entrar</button>
    </form>

    {{#message}}
    <p class="message" role="status">{{message}}</p>
    {{/message}}
</main>
</body>
</html>