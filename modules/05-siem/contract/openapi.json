{
  "openapi": "3.1.0",
  "info": {
    "title": "SIEM · Contrato de integración (SEM-6)",
    "version": "0.2.0-sprint1-review",
    "description": "Each accepted event generates one alert stored in memory (lost on restart). Identical retries are idempotent; a changed resend of the same source and event_id returns 409. Request bodies are limited to 64 KiB and storage to 10000 alerts by default. Intergroup ratification and PO acceptance are pending. No durable persistence, correlation or authentication is implemented."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "http://localhost:8005",
      "description": "Local access"
    },
    {
      "url": "http://siem:80",
      "description": "Docker network ciberurjc"
    }
  ],
  "x-status": "draft-pending-agreement",
  "x-authentication-status": "Pending Identity contract: admin, analista, servicio roles exist; credential format and SIEM endpoint permissions unspecified. No public-access policy is established.",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Salud del módulo",
        "responses": {
          "200": {
            "description": "Respuesta de salud confirmada en la configuración del placeholder.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "ok",
                  "module": "05-siem"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "post": {
        "operationId": "receiveEvent",
        "summary": "Receive a security event and generate its alert",
        "description": "One event per request. The first accepted event for a source and event_id stores one alert; an identical retry returns 200 without changes; different content for the same source and event_id returns 409 and never replaces the stored alert. Bodies over the configured limit (default 65536 bytes) return 413. When storage is full, new alerts return 507. Invalid event bodies return 400.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SecurityEvent"
              },
              "examples": {
                "ids": {
                  "summary": "Simulado, pendiente de grupo 2",
                  "value": {
                    "event_id": "IDS-EJEMPLO-001",
                    "timestamp": "2026-09-22T18:30:15Z",
                    "source": "ids",
                    "event_type": "port_scan",
                    "severity": "medium",
                    "title": "Posible escaneo de puertos",
                    "description": "Una IP ha contactado con 20 puertos del mismo destino en 60 segundos.",
                    "details": {
                      "rule_id": "IDS-001",
                      "source_ip": "192.168.1.50",
                      "target_ip": "192.168.1.10",
                      "protocol": "tcp",
                      "distinct_ports_count": 20,
                      "window_seconds": 60
                    }
                  }
                },
                "honeypot": {
                  "summary": "Ejemplo adaptado disponible",
                  "value": {
                    "event_id": "HP-981839239323",
                    "timestamp": "2026-09-22T18:30:15Z",
                    "source": "honeypot",
                    "event_type": "fuerza_bruta",
                    "severity": "medium",
                    "title": "Intento de fuerza bruta en el honeypot",
                    "description": "El honeypot ha registrado un evento clasificado como fuerza bruta sobre SSH.",
                    "details": {
                      "source_ip": "192.168.1.50",
                      "service": "ssh",
                      "username": "root",
                      "credential": "123456",
                      "command": null
                    }
                  }
                },
                "scanner": {
                  "summary": "Ejemplo adaptado disponible",
                  "value": {
                    "event_id": "b52ee782-265f-4ec7-a719-484460628ef9",
                    "timestamp": "2026-09-29T10:30:00Z",
                    "source": "scanner",
                    "event_type": "vulnerability_detected",
                    "severity": "medium",
                    "title": "Cabecera de seguridad ausente",
                    "description": "El servicio HTTP no devuelve X-Content-Type-Options.",
                    "details": {
                      "target": {
                        "ip": "192.168.56.10",
                        "port": 80,
                        "protocol": "tcp",
                        "service": "http"
                      },
                      "scan_id": "scan-001",
                      "tool": "nmap",
                      "profile": "web",
                      "script_id": "http-headers",
                      "evidence": "X-Content-Type-Options no aparece en las cabeceras recibidas.",
                      "cve": null,
                      "cvss": null
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event accepted. Its alert is stored, or already existed with identical content.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventReceipt"
                },
                "example": {
                  "status": "success",
                  "message": "Event received successfully",
                  "event_id": "HP-981839239323"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON or invalid event, including missing fields, unsupported values or invalid UTC timestamp.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INVALID_JSON": {
                    "value": {
                      "error": {
                        "code": "INVALID_JSON",
                        "message": "The body must match the JSON event structure"
                      }
                    }
                  },
                  "VALIDATION_ERROR": {
                    "value": {
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "The event does not match the required schema"
                      }
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "The same source and event_id was already received with different content. The stored alert is kept unchanged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "EVENT_CONFLICT",
                    "message": "An event with the same source and event_id was already received with different content"
                  }
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds the configured limit (default 65536 bytes).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "PAYLOAD_TOO_LARGE",
                    "message": "The request body exceeds the maximum allowed size"
                  }
                }
              }
            }
          },
          "415": {
            "description": "Tipo de contenido no admitido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "UNSUPPORTED_MEDIA_TYPE",
                    "message": "Content-Type must be application/json"
                  }
                }
              }
            }
          },
          "507": {
            "description": "Alert storage reached its configured capacity (default 10000). Identical retries of stored events still return 200.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "STORAGE_FULL",
                    "message": "Alert storage has reached its capacity"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/alerts": {
      "get": {
        "operationId": "listAlerts",
        "summary": "Consultar alertas",
        "description": "All currently stored alerts without filtering, pagination, truncation or guaranteed order. Empty result: {\"alerts\": []}. In-memory storage is lost on restart.",
        "responses": {
          "200": {
            "description": "Lista de alertas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertsResponse"
                },
                "example": {
                  "alerts": [
                    {
                      "alert_id": "SIEM-ALERT-EJEMPLO-001",
                      "event_id": "IDS-EJEMPLO-001",
                      "timestamp": "2026-09-22T18:30:15Z",
                      "source": "ids",
                      "event_type": "port_scan",
                      "severity": "medium",
                      "title": "Posible escaneo de puertos",
                      "description": "Una IP ha contactado con 20 puertos del mismo destino en 60 segundos.",
                      "source_ip": "192.168.1.50",
                      "target_ip": "192.168.1.10",
                      "details": {
                        "rule_id": "IDS-001",
                        "source_ip": "192.168.1.50",
                        "target_ip": "192.168.1.10",
                        "protocol": "tcp",
                        "distinct_ports_count": 20,
                        "window_seconds": 60
                      }
                    },
                    {
                      "alert_id": "SIEM-ALERT-EJEMPLO-002",
                      "event_id": "HP-981839239323",
                      "timestamp": "2026-09-22T18:30:15Z",
                      "source": "honeypot",
                      "event_type": "fuerza_bruta",
                      "severity": "medium",
                      "title": "Intento de fuerza bruta en el honeypot",
                      "description": "El honeypot ha registrado un evento clasificado como fuerza bruta sobre SSH.",
                      "source_ip": "192.168.1.50",
                      "target_ip": null,
                      "details": {
                        "source_ip": "192.168.1.50",
                        "service": "ssh",
                        "username": "root",
                        "credential": "123456",
                        "command": null
                      }
                    },
                    {
                      "alert_id": "SIEM-ALERT-EJEMPLO-003",
                      "event_id": "b52ee782-265f-4ec7-a719-484460628ef9",
                      "timestamp": "2026-09-29T10:30:00Z",
                      "source": "scanner",
                      "event_type": "vulnerability_detected",
                      "severity": "medium",
                      "title": "Cabecera de seguridad ausente",
                      "description": "El servicio HTTP no devuelve X-Content-Type-Options.",
                      "source_ip": null,
                      "target_ip": "192.168.56.10",
                      "details": {
                        "target": {
                          "ip": "192.168.56.10",
                          "port": 80,
                          "protocol": "tcp",
                          "service": "http"
                        },
                        "scan_id": "scan-001",
                        "tool": "nmap",
                        "profile": "web",
                        "script_id": "http-headers",
                        "evidence": "X-Content-Type-Options no aparece en las cabeceras recibidas.",
                        "cve": null,
                        "cvss": null
                      }
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Alert storage is temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "STORAGE_UNAVAILABLE",
                    "message": "Alert storage is temporarily unavailable"
                  }
                }
              }
            }
          },
          "500": {
            "description": "An unexpected error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "An unexpected error occurred"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/alerts/{id}": {
      "get": {
        "operationId": "getAlert",
        "summary": "Consultar una alerta por alert_id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "SIEM-ALERT-EJEMPLO-001"
          }
        ],
        "responses": {
          "200": {
            "description": "Alerta solicitada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Alert"
                },
                "example": {
                  "alert_id": "SIEM-ALERT-EJEMPLO-001",
                  "event_id": "IDS-EJEMPLO-001",
                  "timestamp": "2026-09-22T18:30:15Z",
                  "source": "ids",
                  "event_type": "port_scan",
                  "severity": "medium",
                  "title": "Posible escaneo de puertos",
                  "description": "Una IP ha contactado con 20 puertos del mismo destino en 60 segundos.",
                  "source_ip": "192.168.1.50",
                  "target_ip": "192.168.1.10",
                  "details": {
                    "rule_id": "IDS-001",
                    "source_ip": "192.168.1.50",
                    "target_ip": "192.168.1.10",
                    "protocol": "tcp",
                    "distinct_ports_count": 20,
                    "window_seconds": 60
                  }
                }
              }
            }
          },
          "404": {
            "description": "Alerta inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "ALERT_NOT_FOUND",
                    "message": "The requested alert does not exist"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Alert storage is temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "STORAGE_UNAVAILABLE",
                    "message": "Alert storage is temporarily unavailable"
                  }
                }
              }
            }
          },
          "500": {
            "description": "An unexpected error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "An unexpected error occurred"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SecurityEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "timestamp",
          "source",
          "event_type",
          "severity",
          "title",
          "description",
          "details"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Unique within source; stable on retries. UUID is not required. Letters, digits, dot, underscore, colon and hyphen only.",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "Original detection time in UTC."
          },
          "source": {
            "type": "string",
            "enum": [
              "ids",
              "honeypot",
              "scanner"
            ]
          },
          "event_type": {
            "type": "string",
            "minLength": 1,
            "description": "Shared catalog pending; existing examples retained.",
            "pattern": "\\S"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Producer-specific data; internal validation pending agreement."
          }
        }
      },
      "Alert": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "timestamp",
          "source",
          "event_type",
          "severity",
          "title",
          "description",
          "details",
          "alert_id",
          "source_ip",
          "target_ip"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique within source; stable on retries. UUID is not required."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "Original detection time in UTC."
          },
          "source": {
            "type": "string",
            "enum": [
              "ids",
              "honeypot",
              "scanner"
            ]
          },
          "event_type": {
            "type": "string",
            "minLength": 1,
            "description": "Shared catalog pending; existing examples retained."
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Producer-specific data; internal validation pending agreement."
          },
          "alert_id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable identifier generated by SIEM."
          },
          "source_ip": {
            "type": [
              "string",
              "null"
            ],
            "format": "ipv4",
            "description": "Observed source IP; null for scanner."
          },
          "target_ip": {
            "type": [
              "string",
              "null"
            ],
            "format": "ipv4",
            "description": "Destination asset; null when unavailable."
          }
        }
      },
      "EventReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "message",
          "event_id"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "success"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "event_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_JSON",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "VALIDATION_ERROR",
                  "ALERT_NOT_FOUND",
                  "INTERNAL_ERROR",
                  "STORAGE_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "module"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "module": {
            "type": "string",
            "const": "05-siem"
          }
        }
      },
      "AlertsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alerts"
        ],
        "properties": {
          "alerts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Alert"
            }
          }
        }
      }
    }
  }
}
