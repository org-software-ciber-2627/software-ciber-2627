                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "An unexpected error occurred"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SecurityEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "timestamp",
          "source",
          "event_type",
          "severity",
          "title",
          "description",
          "details"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Unique within source; stable on retries. UUID is not required. Letters, digits, dot, underscore, colon and hyphen only.",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "Original detection time in UTC."
          },
          "source": {
            "type": "string",
            "enum": [
              "ids",
              "honeypot",
              "scanner",
              "pentesting"
            ]
          },
          "event_type": {
            "type": "string",
            "minLength": 1,
            "description": "Event type reported by the producer.",
            "pattern": "\\S"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ],
            "description": "info denotes an informational observation; it does not imply a vulnerability or generate an alert."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Producer-specific event attributes."
          }
        }
      },
      "Alert": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "timestamp",
          "source",
          "event_type",
          "severity",
          "title",
          "description",
          "details",
          "alert_id",
          "source_ip",
          "target_ip"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique within source; stable on retries. UUID is not required."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "Original detection time in UTC."
          },
          "source": {
            "type": "string",
            "enum": [
              "ids",
              "honeypot",
              "scanner",
              "pentesting"
            ]
          },
          "event_type": {
            "type": "string",
            "minLength": 1,
            "description": "Shared catalog pending; existing examples retained."
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Producer-specific data; internal validation pending agreement."
          },
          "alert_id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable identifier generated by SIEM."
          },
          "source_ip": {
            "type": [
              "string",
              "null"
            ],
            "format": "ipv4",
            "description": "Observed source IP; null for scanner."
          },
          "target_ip": {
            "type": [
              "string",
              "null"
            ],
            "format": "ipv4",
            "description": "Destination asset; null when unavailable."
          }
        }
      },
      "EventReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "message",
          "event_id"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "success"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "event_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_JSON",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "VALIDATION_ERROR",
                  "ALERT_NOT_FOUND",
                  "INTERNAL_ERROR",
                  "EVENT_ID_CONFLICT",
                  "STORAGE_UNAVAILABLE",
                  "PAYLOAD_TOO_LARGE",
                  "STORAGE_FULL"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "module"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "module": {
            "type": "string",
            "const": "05-siem"
          }
        }
      },
      "AlertsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alerts"
        ],
        "properties": {
          "alerts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Alert"
            }
          }
        }
      },
      "EventHistoryResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "events",
          "next_offset",
          "next"
        ],
        "properties": {
          "events": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/SecurityEvent"
            }
          },
          "next_offset": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "next": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri-reference",
            "pattern": "^/(?:[^/?#\\\\]+/)*events\\?limit=[0-9]+&offset=[0-9]+$",
            "description": "Origin-relative continuation reference preserving the Servlet context and requested limit. Resolve against the API origin; no scheme or host is included."
          }
        },
        "oneOf": [
          {
            "properties": {
              "next_offset": {
                "type": "null"
              },
              "next": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "next_offset": {
                "type": "integer"
              },
              "next": {
                "type": "string"
              },
              "events": {
                "minItems": 1
              }
            }
          }
        ],
        "description": "At most the requested limit events; next and next_offset are both null at the end. Continuation observes the extra row at query time and does not provide a snapshot."
      }
    }
  }
}
