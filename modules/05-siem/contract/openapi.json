{
  "openapi": "3.1.0",
  "info": {
    "title": "SIEM · Event ingestion, history and static alerts",
    "version": "0.3.0-sprint2",
    "description": "Sprint 2 branch contract: PostgreSQL event ingestion and paginated event history require the persistence profile. Alerts remain static fixtures. Authentication and authorization are not implemented. This file documents existing ingestion behavior; HU10 does not change POST behavior."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "http://localhost:8005",
      "description": "Local access"
    },
    {
      "url": "http://siem:80",
      "description": "Docker network ciberurjc"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Salud del módulo",
        "responses": {
          "200": {
            "description": "Service health response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "ok",
                  "module": "05-siem"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "post": {
        "operationId": "receiveEvent",
        "summary": "Store a security event",
        "description": "One event per request. With the persistence profile, returns 200 only after storage or an identical replay. Identity is (source, event_id); changed content returns 409. Without the profile, valid events return 503. PostgreSQL must be available at application startup with persistence enabled. Invalid or unrepresentable event data returns 400. Does not generate alerts.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SecurityEvent"
              },
              "examples": {
                "ids": {
                  "summary": "Example IDS event",
                  "value": {
                    "event_id": "IDS-EJEMPLO-001",
                    "timestamp": "2026-09-22T18:30:15Z",
                    "source": "ids",
                    "event_type": "port_scan",
                    "severity": "medium",
                    "title": "Posible escaneo de puertos",
                    "description": "Una IP ha contactado con 20 puertos del mismo destino en 60 segundos.",
                    "details": {
                      "rule_id": "IDS-001",
                      "source_ip": "192.168.1.50",
                      "target_ip": "192.168.1.10",
                      "protocol": "tcp",
                      "distinct_ports_count": 20,
                      "window_seconds": 60
                    }
                  }
                },
                "honeypot": {
                  "summary": "Example honeypot event",
                  "value": {
                    "event_id": "HP-981839239323",
                    "timestamp": "2026-09-22T18:30:15Z",
                    "source": "honeypot",
                    "event_type": "fuerza_bruta",
                    "severity": "medium",
                    "title": "Intento de fuerza bruta en el honeypot",
                    "description": "El honeypot ha registrado un evento clasificado como fuerza bruta sobre SSH.",
                    "details": {
                      "source_ip": "192.168.1.50",
                      "service": "ssh",
                      "username": "root",
                      "credential": "123456",
                      "command": null
                    }
                  }
                },
                "scanner": {
                  "summary": "Example scanner event",
                  "value": {
                    "event_id": "b52ee782-265f-4ec7-a719-484460628ef9",
                    "timestamp": "2026-09-29T10:30:00Z",
                    "source": "scanner",
                    "event_type": "vulnerability_detected",
                    "severity": "medium",
                    "title": "Cabecera de seguridad ausente",
                    "description": "El servicio HTTP no devuelve X-Content-Type-Options.",
                    "details": {
                      "target": {
                        "ip": "192.168.56.10",
                        "port": 80,
                        "protocol": "tcp",
                        "service": "http"
                      },
                      "scan_id": "scan-001",
                      "tool": "nmap",
                      "profile": "web",
                      "script_id": "http-headers",
                      "evidence": "X-Content-Type-Options no aparece en las cabeceras recibidas.",
                      "cve": null,
                      "cvss": null
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event stored or identical replay acknowledged; no duplicate row is inserted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventReceipt"
                },
                "example": {
                  "status": "success",
                  "message": "Event stored successfully",
                  "event_id": "HP-981839239323"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON or invalid event, including missing fields, unsupported values or invalid UTC timestamp.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INVALID_JSON": {
                    "value": {
                      "error": {
                        "code": "INVALID_JSON",
                        "message": "The body must match the JSON event structure"
                      }
                    }
                  },
                  "VALIDATION_ERROR": {
                    "value": {
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "The event does not match the required schema"
                      }
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Tipo de contenido no admitido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "UNSUPPORTED_MEDIA_TYPE",
                    "message": "Content-Type must be application/json"
                  }
                }
              }
            }
          },
          "409": {
            "description": "Same source and event_id with different content; the original row is preserved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "EVENT_ID_CONFLICT",
                    "message": "The event identifier already belongs to different content"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Persistence profile disabled or storage unavailable during the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "STORAGE_UNAVAILABLE",
                    "message": "Event storage is temporarily unavailable"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listEventHistory",
        "summary": "List stored security events",
        "description": "Requires persistence. Fixed order: occurred_at DESC, source ASC, event_id ASC; timestamp retains original_timestamp when available, otherwise UTC occurred_at. limit+1 rows detect continuation without counting the table. Only limit and offset are accepted, each at most once, as 1 to 19 ASCII decimal digits without signs or whitespace. Values must fit a Java long and offset <= 9223372036854775807 - limit. Blank, duplicate and unknown parameters return 400. OFFSET is not a snapshot: concurrent inserts can repeat or skip rows, and large offsets can be costly. The row limit does not bound response bytes. History reads configure a 5-second JDBC statement timeout, not a request deadline. No filters or IAM protection are implemented. next includes the Servlet context; an extra public proxy prefix requires deployment configuration.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum returned events. Integer value represented using 1 to 19 ASCII digits.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            },
            "example": 100
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Rows skipped in fixed order. Integer value represented using 1 to 19 ASCII digits. Must also satisfy offset <= 9223372036854775807 - limit.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "maximum": 9223372036854775806,
              "default": 0
            },
            "example": 0
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted events in fixed order; empty collections return 200. No total count.",
            "headers": {
              "Cache-Control": {
                "description": "Prevents caching event data and handled history errors.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventHistoryResponse"
                },
                "examples": {
                  "empty": {
                    "value": {
                      "events": [],
                      "next_offset": null,
                      "next": null
                    }
                  },
                  "lastPage": {
                    "value": {
                      "events": [
                        {
                          "event_id": "HISTORY-EXAMPLE-001",
                          "timestamp": "2026-10-29T12:00:00.123456789Z",
                          "source": "scanner",
                          "event_type": "vulnerability_detected",
                          "severity": "low",
                          "title": "History example",
                          "description": "Synthetic history contract fixture",
                          "details": {
                            "nested": [
                              null,
                              true,
                              42
                            ],
                            "decimal": 1.25
                          }
                        }
                      ],
                      "next_offset": null,
                      "next": null
                    }
                  },
                  "continuation": {
                    "value": {
                      "events": [
                        {
                          "event_id": "HISTORY-EXAMPLE-001",
                          "timestamp": "2026-10-29T12:00:00.123456789Z",
                          "source": "scanner",
                          "event_type": "vulnerability_detected",
                          "severity": "low",
                          "title": "History example",
                          "description": "Synthetic history contract fixture",
                          "details": {
                            "nested": [
                              null,
                              true,
                              42
                            ],
                            "decimal": 1.25
                          }
                        }
                      ],
                      "next_offset": 1,
                      "next": "/events?limit=1&offset=1"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid, duplicate, unknown or unsafe query parameters.",
            "headers": {
              "Cache-Control": {
                "description": "Prevents caching event data and handled history errors.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "VALIDATION_ERROR"
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Invalid history query parameters"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Persistence disabled, unavailable storage or query timeout.",
            "headers": {
              "Cache-Control": {
                "description": "Prevents caching event data and handled history errors.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "STORAGE_UNAVAILABLE"
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "error": {
                    "code": "STORAGE_UNAVAILABLE",
                    "message": "Event storage is temporarily unavailable"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected history execution error; internal details are not exposed.",
            "headers": {
              "Cache-Control": {
                "description": "Prevents caching event data and handled history errors.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "INTERNAL_ERROR"
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Event history could not be retrieved"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/alerts": {
      "get": {
        "operationId": "listAlerts",
        "summary": "Consultar alertas",
        "description": "Static alerts without filtering, pagination or guaranteed order. Empty result: {\"alerts\": []}.",
        "responses": {
          "200": {
            "description": "Lista de alertas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertsResponse"
                },
                "example": {
                  "alerts": [
                    {
                      "alert_id": "SIEM-ALERT-EJEMPLO-001",
                      "event_id": "IDS-EJEMPLO-001",
                      "timestamp": "2026-09-22T18:30:15Z",
                      "source": "ids",
                      "event_type": "port_scan",
                      "severity": "medium",
                      "title": "Posible escaneo de puertos",
                      "description": "Una IP ha contactado con 20 puertos del mismo destino en 60 segundos.",
                      "source_ip": "192.168.1.50",
                      "target_ip": "192.168.1.10",
                      "details": {
                        "rule_id": "IDS-001",
                        "source_ip": "192.168.1.50",
                        "target_ip": "192.168.1.10",
                        "protocol": "tcp",
                        "distinct_ports_count": 20,
                        "window_seconds": 60
                      }
                    },
                    {
                      "alert_id": "SIEM-ALERT-EJEMPLO-002",
                      "event_id": "HP-981839239323",
                      "timestamp": "2026-09-22T18:30:15Z",
                      "source": "honeypot",
                      "event_type": "fuerza_bruta",
                      "severity": "medium",
                      "title": "Intento de fuerza bruta en el honeypot",
                      "description": "El honeypot ha registrado un evento clasificado como fuerza bruta sobre SSH.",
                      "source_ip": "192.168.1.50",
                      "target_ip": null,
                      "details": {
                        "source_ip": "192.168.1.50",
                        "service": "ssh",
                        "username": "root",
                        "credential": "123456",
                        "command": null
                      }
                    },
                    {
                      "alert_id": "SIEM-ALERT-EJEMPLO-003",
                      "event_id": "b52ee782-265f-4ec7-a719-484460628ef9",
                      "timestamp": "2026-09-29T10:30:00Z",
                      "source": "scanner",
                      "event_type": "vulnerability_detected",
                      "severity": "medium",
                      "title": "Cabecera de seguridad ausente",
                      "description": "El servicio HTTP no devuelve X-Content-Type-Options.",
                      "source_ip": null,
                      "target_ip": "192.168.56.10",
                      "details": {
                        "target": {
                          "ip": "192.168.56.10",
                          "port": 80,
