{
  "openapi": "3.1.0",
  "info": {
    "title": "SIEM · Event ingestion and static alerts",
    "version": "0.3.0-sprint2",
    "description": "Persistent event ingestion supports info, low, medium, high and critical. Requires the persistence profile and database migrations. Alerts remain static fixtures with their existing four severity values. Authentication, authorization and alert correlation are not implemented."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "http://localhost:8005",
      "description": "Local access"
    },
    {
      "url": "http://siem:80",
      "description": "Docker network ciberurjc"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Salud del módulo",
        "responses": {
          "200": {
            "description": "Service health response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "ok",
                  "module": "05-siem"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "post": {
        "operationId": "receiveEvent",
        "summary": "Store a security event",
        "description": "One event per request. With persistence enabled, returns 200 only after storage or an identical replay. Identity is (source, event_id); changed content returns 409. Valid events return 503 when persistence is disabled or unavailable. PostgreSQL must be accessible at application startup with the profile enabled. Invalid or unrepresentable events return 400. Receiving info does not generate an alert.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SecurityEvent"
              },
              "examples": {
                "ids": {
                  "summary": "Example IDS event",
                  "value": {
                    "event_id": "IDS-EJEMPLO-001",
                    "timestamp": "2026-09-22T18:30:15Z",
                    "source": "ids",
                    "event_type": "port_scan",
                    "severity": "medium",
                    "title": "Posible escaneo de puertos",
                    "description": "Una IP ha contactado con 20 puertos del mismo destino en 60 segundos.",
                    "details": {
                      "rule_id": "IDS-001",
                      "source_ip": "192.168.1.50",
                      "target_ip": "192.168.1.10",
                      "protocol": "tcp",
                      "distinct_ports_count": 20,
                      "window_seconds": 60
                    }
                  }
                },
                "honeypot": {
                  "summary": "Example honeypot event",
                  "value": {
                    "event_id": "HP-981839239323",
                    "timestamp": "2026-09-22T18:30:15Z",
                    "source": "honeypot",
                    "event_type": "fuerza_bruta",
                    "severity": "medium",
                    "title": "Intento de fuerza bruta en el honeypot",
                    "description": "El honeypot ha registrado un evento clasificado como fuerza bruta sobre SSH.",
                    "details": {
                      "source_ip": "192.168.1.50",
                      "service": "ssh",
                      "username": "root",
                      "credential": "123456",
                      "command": null
                    }
                  }
                },
                "scanner": {
                  "summary": "Example scanner event",
                  "value": {
                    "event_id": "b52ee782-265f-4ec7-a719-484460628ef9",
                    "timestamp": "2026-09-29T10:30:00Z",
                    "source": "scanner",
                    "event_type": "vulnerability_detected",
                    "severity": "medium",
                    "title": "Cabecera de seguridad ausente",
                    "description": "El servicio HTTP no devuelve X-Content-Type-Options.",
                    "details": {
                      "target": {
                        "ip": "192.168.56.10",
                        "port": 80,
                        "protocol": "tcp",
                        "service": "http"
                      },
                      "scan_id": "scan-001",
                      "tool": "nmap",
                      "profile": "web",
                      "script_id": "http-headers",
                      "evidence": "X-Content-Type-Options no aparece en las cabeceras recibidas.",
                      "cve": null,
                      "cvss": null
                    }
                  }
                },
                "scannerInfo": {
                  "summary": "Informational scanner observation; target address is a sanitized placeholder.",
                  "value": {
                    "event_id": "SCAN-INFO-EXAMPLE-001",
                    "timestamp": "2026-09-29T10:30:00Z",
                    "source": "scanner",
                    "event_type": "service_detected",
                    "severity": "info",
                    "title": "Service detected: http",
                    "description": "HTTP service detected on TCP port 80.",
                    "details": {
                      "target": {
                        "ip": "192.168.X.X",
                        "port": 80,
                        "protocol": "tcp",
                        "service": "http"
                      },
                      "scan_id": "SCAN-EXAMPLE-001",
                      "tool": "nmap",
                      "profile": "web",
                      "script_id": null,
                      "evidence": null,
                      "cve": null,
                      "cvss": null
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event stored or identical replay acknowledged without inserting another row.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventReceipt"
                },
                "example": {
                  "status": "success",
                  "message": "Event stored successfully",
                  "event_id": "HP-981839239323"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON or invalid event, including missing fields, unsupported values or invalid UTC timestamp.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INVALID_JSON": {
                    "value": {
                      "error": {
                        "code": "INVALID_JSON",
                        "message": "The body must match the JSON event structure"
                      }
                    }
                  },
                  "VALIDATION_ERROR": {
                    "value": {
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "The event does not match the required schema"
                      }
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Tipo de contenido no admitido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "UNSUPPORTED_MEDIA_TYPE",
                    "message": "Content-Type must be application/json"
                  }
                }
              }
            }
          },
          "409": {
            "description": "Same source and event_id with different content; the original is preserved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "EVENT_ID_CONFLICT",
                    "message": "The event identifier already belongs to different content"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Persistence disabled or storage unavailable during the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "STORAGE_UNAVAILABLE",
                    "message": "Event storage is temporarily unavailable"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/alerts": {
      "get": {
        "operationId": "listAlerts",
        "summary": "Consultar alertas",
        "description": "Static alerts without filtering, pagination or guaranteed order. Empty result: {\"alerts\": []}.",
        "responses": {
          "200": {
            "description": "Lista de alertas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertsResponse"
                },
                "example": {
                  "alerts": [
                    {
                      "alert_id": "SIEM-ALERT-EJEMPLO-001",
                      "event_id": "IDS-EJEMPLO-001",
                      "timestamp": "2026-09-22T18:30:15Z",
                      "source": "ids",
                      "event_type": "port_scan",
                      "severity": "medium",
                      "title": "Posible escaneo de puertos",
                      "description": "Una IP ha contactado con 20 puertos del mismo destino en 60 segundos.",
                      "source_ip": "192.168.1.50",
                      "target_ip": "192.168.1.10",
                      "details": {
                        "rule_id": "IDS-001",
                        "source_ip": "192.168.1.50",
                        "target_ip": "192.168.1.10",
                        "protocol": "tcp",
                        "distinct_ports_count": 20,
                        "window_seconds": 60
                      }
                    },
                    {
                      "alert_id": "SIEM-ALERT-EJEMPLO-002",
                      "event_id": "HP-981839239323",
                      "timestamp": "2026-09-22T18:30:15Z",
                      "source": "honeypot",
                      "event_type": "fuerza_bruta",
                      "severity": "medium",
                      "title": "Intento de fuerza bruta en el honeypot",
                      "description": "El honeypot ha registrado un evento clasificado como fuerza bruta sobre SSH.",
                      "source_ip": "192.168.1.50",
                      "target_ip": null,
                      "details": {
                        "source_ip": "192.168.1.50",
                        "service": "ssh",
                        "username": "root",
                        "credential": "123456",
                        "command": null
                      }
                    },
                    {
                      "alert_id": "SIEM-ALERT-EJEMPLO-003",
                      "event_id": "b52ee782-265f-4ec7-a719-484460628ef9",
                      "timestamp": "2026-09-29T10:30:00Z",
                      "source": "scanner",
                      "event_type": "vulnerability_detected",
                      "severity": "medium",
                      "title": "Cabecera de seguridad ausente",
                      "description": "El servicio HTTP no devuelve X-Content-Type-Options.",
                      "source_ip": null,
                      "target_ip": "192.168.56.10",
                      "details": {
                        "target": {
                          "ip": "192.168.56.10",
                          "port": 80,
                          "protocol": "tcp",
                          "service": "http"
                        },
                        "scan_id": "scan-001",
                        "tool": "nmap",
                        "profile": "web",
                        "script_id": "http-headers",
                        "evidence": "X-Content-Type-Options no aparece en las cabeceras recibidas.",
                        "cve": null,
                        "cvss": null
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/alerts/{id}": {
      "get": {
        "operationId": "getAlert",
        "summary": "Consultar una alerta por alert_id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "SIEM-ALERT-EJEMPLO-001"
          }
        ],
        "responses": {
          "200": {
            "description": "Alerta solicitada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Alert"
                },
                "example": {
                  "alert_id": "SIEM-ALERT-EJEMPLO-001",
                  "event_id": "IDS-EJEMPLO-001",
                  "timestamp": "2026-09-22T18:30:15Z",
                  "source": "ids",
                  "event_type": "port_scan",
                  "severity": "medium",
                  "title": "Posible escaneo de puertos",
                  "description": "Una IP ha contactado con 20 puertos del mismo destino en 60 segundos.",
                  "source_ip": "192.168.1.50",
                  "target_ip": "192.168.1.10",
                  "details": {
                    "rule_id": "IDS-001",
                    "source_ip": "192.168.1.50",
                    "target_ip": "192.168.1.10",
                    "protocol": "tcp",
                    "distinct_ports_count": 20,
                    "window_seconds": 60
                  }
                }
              }
            }
          },
          "404": {
            "description": "Alerta inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "ALERT_NOT_FOUND",
                    "message": "The requested alert does not exist"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SecurityEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "timestamp",
          "source",
          "event_type",
          "severity",
          "title",
          "description",
          "details"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique within source; stable on retries. UUID is not required.",
            "pattern": "\\S"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "Original detection time in UTC."
          },
          "source": {
            "type": "string",
            "enum": [
              "ids",
              "honeypot",
              "scanner"
            ]
          },
          "event_type": {
            "type": "string",
            "minLength": 1,
            "description": "Event type reported by the producer.",
            "pattern": "\\S"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ],
            "description": "info denotes an informational observation; it does not imply a vulnerability or generate an alert."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Producer-specific event attributes."
          }
        }
      },
      "Alert": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "timestamp",
          "source",
          "event_type",
          "severity",
          "title",
          "description",
          "details",
          "alert_id",
          "source_ip",
          "target_ip"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique within source; stable on retries. UUID is not required."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "Original detection time in UTC."
          },
          "source": {
            "type": "string",
            "enum": [
              "ids",
              "honeypot",
              "scanner"
            ]
          },
          "event_type": {
            "type": "string",
            "minLength": 1,
            "description": "Event type reported by the producer."
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Producer-specific event attributes."
          },
          "alert_id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable identifier generated by SIEM."
          },
          "source_ip": {
            "type": [
              "string",
              "null"
            ],
            "format": "ipv4",
            "description": "Observed source IP; null for scanner."
          },
          "target_ip": {
            "type": [
              "string",
              "null"
            ],
            "format": "ipv4",
            "description": "Destination asset; null when unavailable."
          }
        }
      },
      "EventReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "message",
          "event_id"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "success"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "event_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_JSON",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "VALIDATION_ERROR",
                  "ALERT_NOT_FOUND",
                  "INTERNAL_ERROR",
                  "EVENT_ID_CONFLICT",
                  "STORAGE_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "module"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "module": {
            "type": "string",
            "const": "05-siem"
          }
        }
      },
      "AlertsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alerts"
        ],
        "properties": {
          "alerts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Alert"
            }
          }
        }
      }
    }
  }
}
